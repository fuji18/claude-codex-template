{
  "$comment": "テンプレート追従の単一ソース。/sync-template と .github/workflows/template-update-check.yml が参照する。owned=上書き / merge=手動統合 / never=触らない。パスが複数に該当する場合は**最も具体的な(長い)エントリが勝つ**(例: .claude/scripts/ は owned だが .claude/scripts/lint-on-edit.sh は merge)。同じ長さなら owned > merge > never。末尾が / のエントリはディレクトリ配下すべてを指す。どの区分にも無い追跡ファイルはテンプレート本体の CI(check-manifest-coverage.sh)が落とす。syncedAt はテンプレート側の commit SHA(未同期なら null)。",
  "templateRepo": "https://github.com/fuji18/claude-codex-template.git",
  "templateBranch": "main",
  "syncedAt": null,
  "syncedDate": null,
  "owned": [
    ".claude/rules/",
    ".claude/commands/",
    ".claude/skills/",
    ".claude/agents/",
    ".claude/hooks/",
    ".claude/scripts/",
    ".claude/docs/",
    ".github/workflows/claude.yml",
    ".github/workflows/claude-code-review.yml",
    ".github/workflows/template-update-check.yml",
    ".github/workflows/record-hygiene.yml",
    ".github/pull_request_template.md",
    "docs/ui-design-request-template.md",
    ".codex/skills/"
  ],
  "merge": [
    ".github/workflows/ci.yml",
    "docs/ui-design-guidelines.md",
    ".claude/settings.json",
    ".claude/branch-policy.json",
    ".claude/autopilot.json",
    ".claude/routing.json",
    ".claude/codex-denylist.txt",
    ".claude/template-manifest.json",
    ".github/dependabot.yml",
    ".husky/pre-commit",
    ".husky/prepare-commit-msg",
    ".secretlintrc.json",
    ".gitattributes",
    ".gitignore",
    "AGENTS.md",
    ".codex/config.toml",
    ".claude/hooks/session-start.sh",
    ".claude/scripts/lint-on-edit.sh",
    ".prettierignore",
    ".secretlintignore"
  ],
  "never": [
    "CLAUDE.md",
    "README.md",
    "LICENSE",
    "docs/",
    ".steering/",
    "src/",
    "package.json",
    "package-lock.json",
    ".devcontainer/",
    ".claude/settings.local.json",
    ".mcp.json",
    "tsconfig.json",
    "vitest.config.ts",
    "eslint.config.js",
    ".prettierrc",
    ".harness/"
  ]
}
